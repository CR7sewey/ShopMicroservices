
@if (User.Identity.IsAuthenticated)
{
    <li class="nav-item">
        Hello, @User.Identity.Name - 
        <a class="nav-link text-capitalize" asp-area="" asp-controller="Home" asp-action="Logout"
           style="color: blue">Logout</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-capitalize" asp-area="" asp-controller="Home" asp-action="Login"
           style="color: blue">Login</a>
    </li>
}

